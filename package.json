{
  "name": "ruusian-retro-emulator",
  "version": "1.0.0",
  "description": "Retro NES emulator by Ruusian",
  "main": "src/server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "dashboard": "node dashboard.js",
    "stop": "lsof -ti :3000 | xargs -r kill -9 2>/dev/null || pkill -f 'src/server.js' 2>/dev/null || true",
    "lint": "eslint src/ dashboard.js install.js",
    "format": "prettier --write \"src/**/*.js\" dashboard.js install.js *.sh",
    "test": "node test/rom-utils.test.js"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.3.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "morgan": "^1.11.0",
    "multer": "^2.2.0"
  }
}
